# MongoDB connection string (Atlas or local), e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name
MONGODB_DB=atom-hub
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Sign-up is always open until the first account exists. Set to "true" to allow more accounts later.
ALLOW_SIGNUP=false
# Web Push — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret for the reminder cron endpoint (/api/cron/notify). Generate with: openssl rand -base64 24
CRON_SECRET=
